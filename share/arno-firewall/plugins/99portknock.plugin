# ------------------------------------------------------------------------------
#            -= Arno's (NFT) Firewall(ANF) - Port Knocking plugin =-
#
PLUGIN_NAME="Port Knocking plugin"
PLUGIN_VERSION="1.0"
PLUGIN_CONF_FILE="portknock.conf"
#
# Last changed          : November 10, 2026
# Requirements          : ANF 3.0.0 (or newer)
# Comments              : Open configured TCP/UDP ports on this firewall host
#                         for a limited time after a configured sequence of
#                         knocks (TCP SYN or UDP packets). Implemented entirely
#                         in nftables (dynamic sets with timeouts): no daemon
#                         and no log parsing. Inspired by knockd.
#
# Web                   : https://github.com/arno-firewall/anf
# ------------------------------------------------------------------------------
# This program is free software; you can redistribute it and/or
# modify it under the terms of the GNU General Public License
# version 2 as published by the Free Software Foundation.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
