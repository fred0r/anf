#!/bin/sh

CONF="${PORTKNOCK_CONF:-/etc/arno-firewall/plugins/portknock.conf}"
NFT="${NFT:-nft}"
NFT_TABLE="${NFT_TABLE:-anf}"
STOP_FLAG="${PORTKNOCK_CLOSE_DISABLED:-/run/anf_portknock_close.disabled}"
HELPER_DIR="${0%/*}"
TIMER="$HELPER_DIR/portknock-close-timer"

[ -e "$STOP_FLAG" ] && exit 0
[ -r "$CONF" ] || exit 0
[ -f "$TIMER" ] || exit 0

# rsyslog's legacy execute action passes the message as argv[1]; accept stdin too.
if [ "$#" -gt 0 ]; then
  msg="$*"
else
  IFS= read -r msg
fi

case "$msg" in
  *"ANF:Portknock opened:"*) ;;
  *) exit 0 ;;
esac

ENABLED=0
PORTKNOCK_ALLOW_ALL=0
PORTKNOCK_OPEN=""
. "$CONF"

[ "$ENABLED" = "1" ] || exit 0
[ "$PORTKNOCK_LOG" = "1" ] || exit 0
[ -n "$PORTKNOCK_OPEN" ] || exit 0

in_if="$(printf '%s\n' "$msg" | sed -n 's/.*[[:space:]]IN=\([^[:space:]]*\).*/\1/p')"
src_ip="$(printf '%s\n' "$msg" | sed -n 's/.*[[:space:]]SRC=\([^[:space:]]*\).*/\1/p')"

if [ "$PORTKNOCK_ALLOW_ALL" = "1" ]; then
  key="$in_if"
  set_name="anf_pk_open_ifs"
  case "$key" in
    ""|*[!A-Za-z0-9_.+-]*) exit 0 ;;
  esac
else
  key="$src_ip"
  case "$key" in
    ""|*[!0-9A-Fa-f:.]*) exit 0 ;;
    *:*) set_name="anf_pk_allowed_6" ;;
    *)   set_name="anf_pk_allowed_4" ;;
  esac
fi

if command -v start-stop-daemon >/dev/null 2>&1; then
  if start-stop-daemon -S -b -x /bin/sh -- \
       "$TIMER" "$NFT_TABLE" "$set_name" "$key" "$PORTKNOCK_OPEN" "$NFT" "$in_if" >/dev/null 2>&1; then
    exit 0
  fi
fi

/bin/sh "$TIMER" "$NFT_TABLE" "$set_name" "$key" "$PORTKNOCK_OPEN" "$NFT" "$in_if" </dev/null >/dev/null 2>&1 &
exit 0
