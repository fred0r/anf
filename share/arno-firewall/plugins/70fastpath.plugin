# ------------------------------------------------------------------------------
#            -= Arno's (NFT) Firewall(ANF) - Flow Offload (fastpath) =-
#
PLUGIN_NAME="Flow Offload (fastpath) plugin (PC Engines APU2)"
PLUGIN_VERSION="1.07"
PLUGIN_CONF_FILE="fastpath.conf"
#
# Last changed          : November 5, 2026
# Requirements          : ANF 3.0.0 (or newer)
# Target hardware       : PC Engines APU2 (AMD GX-412TC quad-core, Intel i211
#                         "igb" NICs), typically with a PPPoE WAN.
# Comments              : Enable the nftables flowtable fastpath for forwarded
#                         traffic (in an isolated "inet fastpath" table), and
#                         optionally tune flowtable timeouts, the CPU scaling
#                         governor and the NIC ring buffers, and flush stale
#                         conntrack entries when the WAN address changes.
#
# Web                   : https://github.com/arno-firewall/anf
# ------------------------------------------------------------------------------
# This program is free software; you can redistribute it and/or
# modify it under the terms of the GNU General Public License
# version 2 as published by the Free Software Foundation.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program; if not, write to the Free Software
# Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.
# ------------------------------------------------------------------------------

# (Background) job name
JOB_NAME="fastpath"

# (Background) job helper script
JOB_HELPER_SCRIPT="$PLUGIN_BIN_PATH/fastpath-helper"

# (State) file storing the fingerprint ("device=ifindex") of the devices in the
# running fastpath, so a (re)built netdev can be detected
FASTPATH_STATE="/var/tmp/anf_fastpath_state"

# (State) file storing the last seen WAN IPv4 address(es), to detect a change
FASTPATH_WAN_IP_STATE="/var/tmp/anf_fastpath_wan_ips"

# (State) file storing the last seen global WAN IPv6 address(es), to detect a
# change (only used when IPV6_SUPPORT=1)
FASTPATH_WAN_IP6_STATE="/var/tmp/anf_fastpath_wan_ip6s"


# Only regular files may be used for our state. A symlink (or any other type)
# is left alone, so it can never redirect a root write somewhere else.
fastpath_state_safe()
{
  local file="$1"

  [ -n "$file" ] || return 1
  [ -L "$file" ] && return 1
  [ -e "$file" ] && [ ! -f "$file" ] && return 1

  return 0
}


fastpath_state_read()
{
  local file="$1"

  fastpath_state_safe "$file" || return 1
  [ -f "$file" ] || return 0

  cat "$file" 2>/dev/null
}


fastpath_valid_ifname()
{
  case "$1" in
    ""|*[!A-Za-z0-9_.-]*) return 1 ;;
  esac

  return 0
}


set_flowtable_timeouts()
{
  if [ -n "$FASTPATH_TCP_TIMEOUT" ]; then
    case "$FASTPATH_TCP_TIMEOUT" in
      *[!0-9]*) printf '%s\n' "** WARNING: Ignoring invalid FASTPATH_TCP_TIMEOUT setting. **" >&2 ;;
           *) sysctl -w "net.netfilter.nf_flowtable_tcp_timeout=$FASTPATH_TCP_TIMEOUT" >/dev/null 2>&1 ;;
    esac
  fi

  if [ -n "$FASTPATH_UDP_TIMEOUT" ]; then
    case "$FASTPATH_UDP_TIMEOUT" in
      *[!0-9]*) printf '%s\n' "** WARNING: Ignoring invalid FASTPATH_UDP_TIMEOUT setting. **" >&2 ;;
           *) sysctl -w "net.netfilter.nf_flowtable_udp_timeout=$FASTPATH_UDP_TIMEOUT" >/dev/null 2>&1 ;;
    esac
  fi

  return 0
}


set_governor()
{
  local cpu

  [ -n "$FASTPATH_GOVERNOR" ] || return 0

  case "$FASTPATH_GOVERNOR" in
    *[!A-Za-z0-9_-]*) printf '%s\n' "** WARNING: Ignoring invalid FASTPATH_GOVERNOR setting. **" >&2
                      return 0 ;;
  esac

  for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$cpu" ] && printf '%s\n' "$FASTPATH_GOVERNOR" > "$cpu" 2>/dev/null
  done
  return 0
}


set_nic_rings()
{
  local ifaces iface

  if [ -z "$FASTPATH_RING_RX" ] || [ -z "$FASTPATH_RING_TX" ]; then
    return 0
  fi

  case "$FASTPATH_RING_RX" in
    *[!0-9]*) printf '%s\n' "** WARNING: Ignoring invalid FASTPATH_RING_RX setting. **" >&2
              return 0 ;;
  esac

  case "$FASTPATH_RING_TX" in
    *[!0-9]*) printf '%s\n' "** WARNING: Ignoring invalid FASTPATH_RING_TX setting. **" >&2
              return 0 ;;
  esac

  if [ -n "$FASTPATH_NIC_RINGS" ]; then
    ifaces="$FASTPATH_NIC_RINGS"
  else
    ifaces=""
    for iface in /sys/class/net/*; do
      [ -e "$iface/device" ] || continue
      iface="${iface##*/}"
      [ "$iface" = "lo" ] && continue
      ifaces="$ifaces${ifaces:+ }$iface"
    done
  fi

  [ -n "$ifaces" ] || return 0

  for iface in $ifaces; do
    fastpath_valid_ifname "$iface" || {
      printf '%s\n' "** WARNING: Ignoring invalid interface name \"$iface\". **" >&2
      continue
    }
    ethtool -G "$iface" rx "$FASTPATH_RING_RX" tx "$FASTPATH_RING_TX" >/dev/null 2>&1
  done
  return 0
}


# Plugin start function
plugin_start()
{
  if [ -n "$FASTPATH_NIC_RINGS" ]; then
    printf '%s\n' "${INDENT}Flow Offload - NIC rings on: $FASTPATH_NIC_RINGS"
  else
    printf '%s\n' "${INDENT}Flow Offload - NIC rings on all hardware NICs"
  fi

  set_flowtable_timeouts
  set_governor
  set_nic_rings

  # Build the fastpath now; the helper is a no-op until the WAN devices exist
  job_run_once "$JOB_HELPER_SCRIPT" >/dev/null 2>&1

  # Keep it in sync (eg. once the WAN interface appears)
  if ! job_add "$JOB_NAME" 1 "$JOB_HELPER_SCRIPT"; then
    return 1
  fi

  return 0
}


# Plugin restart function
plugin_restart()
{
  case "${FASTPATH_FLUSH_ON_RESTART:-1}" in
    1) "$NFT" delete table inet fastpath 2>/dev/null
       rm -f "$FASTPATH_STATE" ;;
    0) ;;
    *) printf '%s\n' "** WARNING: Invalid FASTPATH_FLUSH_ON_RESTART value, keeping flows. **" >&2 ;;
  esac

  # Skip plugin_stop on a restart
  plugin_start

  return 0
}


# Plugin stop function
plugin_stop()
{
  printf '%s' "${INDENT}Flow Offload - Stopping... "

  job_remove "$JOB_NAME" >/dev/null 2>&1
  "$NFT" delete table inet fastpath 2>/dev/null
  rm -f "$FASTPATH_STATE" "$FASTPATH_WAN_IP_STATE" "$FASTPATH_WAN_IP6_STATE"

  printf '%s\n' "done"

  return 0
}


# Plugin status function
plugin_status()
{
  printf '%s\n' "  Flowtable:"
  printf '%s\n' "  =============================="
  "$NFT" list flowtable inet fastpath fp 2>/dev/null
  printf '%s\n' "  ------------------------------"
  printf '%s\n' "  Tracked WAN IPv4(s): $(fastpath_state_read "$FASTPATH_WAN_IP_STATE")"
  if [ "${IPV6_SUPPORT:-0}" = "1" ]; then
    printf '%s\n' "  Tracked WAN IPv6(s): $(fastpath_state_read "$FASTPATH_WAN_IP6_STATE")"
  fi
  printf '%s\n' "  Offloaded connections: $(grep -c OFFLOAD /proc/net/nf_conntrack 2>/dev/null)"
  printf '%s\n' ""

  return 0
}


# Check sanity of eg. environment
plugin_sanity_check()
{
  if ! check_command nft; then
    printf "\033[40m\033[1;31m${INDENT}ERROR: Required command nft is not available!\033[0m\n" >&2
    return 1
  fi

  if ! check_command mktemp; then
    printf "\033[40m\033[1;31m${INDENT}ERROR: Required command mktemp is not available!\033[0m\n" >&2
    return 1
  fi

  if [ -n "$FASTPATH_NIC_RINGS" ] && ! check_command ethtool; then
    printf "\033[40m\033[1;31m${INDENT}ERROR: Required command ethtool is not available!\033[0m\n" >&2
    return 1
  fi

  if [ "${FASTPATH_FLUSH_CONNTRACK:-1}" = "1" ] && ! check_command conntrack; then
    printf "\033[40m\033[1;31m${INDENT}ERROR: Required command conntrack is not available!\033[0m\n" >&2
    return 1
  fi

  return 0
}


############
# Mainline #
############

# Check where to find the config file
CONF_FILE=""
if [ -n "$PLUGIN_CONF_PATH" ]; then
  CONF_FILE="$PLUGIN_CONF_PATH/$PLUGIN_CONF_FILE"
fi

# Preinit to success:
PLUGIN_RET_VAL=0

# Check if the config file exists
if [ ! -f "$CONF_FILE" ]; then
  printf '%s\n' "NOTE: Config file \"$CONF_FILE\" not found!" >&2
  printf '%s\n' "        Plugin \"$PLUGIN_NAME v$PLUGIN_VERSION\" ignored!" >&2
else
  # Source the plugin config file
  . "$CONF_FILE"

  if [ "$ENABLED" = "1" -a "$PLUGIN_CMD" != "stop-restart" ] ||
     [ "$ENABLED" = "0" -a "$PLUGIN_CMD" = "stop-restart" ] ||
     [ -n "$PLUGIN_LOAD_FILE" -a "$PLUGIN_CMD" = "stop" ] ||
     [ -n "$PLUGIN_LOAD_FILE" -a "$PLUGIN_CMD" = "status" ]; then
    # Show who we are:
    echo "${INDENT}$PLUGIN_NAME v$PLUGIN_VERSION"

    # Increment indention
    INDENT="$INDENT "

    # Only proceed if environment ok
    if ! plugin_sanity_check; then
      PLUGIN_RET_VAL=1
    else
      case $PLUGIN_CMD in
        start|''         ) plugin_start; PLUGIN_RET_VAL=$? ;;
        restart          ) plugin_restart; PLUGIN_RET_VAL=$? ;;
        stop|stop-restart) plugin_stop; PLUGIN_RET_VAL=$? ;;
        status           ) plugin_status; PLUGIN_RET_VAL=$? ;;
        *                ) PLUGIN_RET_VAL=1; printf "\033[40m\033[1;31m${INDENT}ERROR: Invalid plugin option \"$PLUGIN_CMD\"!\033[0m\n" >&2 ;;
      esac
    fi
  fi
fi
