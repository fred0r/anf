#!/bin/sh

TABLE="${1:-anf}"
SET="${2:-}"
KEY="${3:-}"
PORTS="${4:-}"
NFT="${5:-nft}"
IN_IF="${6:-}"
STOP_FLAG="${PORTKNOCK_CLOSE_DISABLED:-/run/anf_portknock_close.disabled}"
LOCK_DIR="${PORTKNOCK_TIMER_DIR:-/run/anf_portknock_timers}"

[ -n "$SET" ] || exit 1
[ -n "$KEY" ] || exit 1
[ -e "$STOP_FLAG" ] && exit 0

case "$SET" in
  anf_pk_open_ifs) LABEL="interface" ;;
  *)               LABEL="source" ;;
esac

umask 077
mkdir -p "$LOCK_DIR" || exit 1
LOCK="$LOCK_DIR/$SET.$KEY"

if ! mkdir "$LOCK" 2>/dev/null; then
  old_pid="$(cat "$LOCK/pid" 2>/dev/null)"
  if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
    exit 0
  fi
  rm -rf "$LOCK"
  mkdir "$LOCK" 2>/dev/null || exit 0
fi

echo $$ >"$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT HUP INT TERM

portknock_ms()
{
  local s="$1" total=0 num unit

  while [ -n "$s" ]; do
    num="${s%%[!0-9]*}"
    [ -n "$num" ] || return 1
    s="${s#"$num"}"

    case "$s" in
      ms*) unit=1; s="${s#ms}" ;;
      d*)  unit=86400000; s="${s#d}" ;;
      h*)  unit=3600000; s="${s#h}" ;;
      m*)  unit=60000; s="${s#m}" ;;
      s*)  unit=1000; s="${s#s}" ;;
      *)   return 1 ;;
    esac

    total=$((total + num * unit))
  done

  printf '%s\n' "$total"
}


portknock_entries()
{
  local out elements elem token prev key expires ms

  out="$("$NFT" list set inet "$TABLE" "$SET" 2>/dev/null)" || return 1

  elements="$(printf '%s' "$out" | tr '\n' ' ' |
    sed -n 's/.*elements = { *\([^}]*\)}.*/\1/p')"
  [ -n "$elements" ] || return 0

  printf '%s\n' "$elements" | tr ',' '\n' | while IFS= read -r elem; do
    [ -n "$elem" ] || continue
    key=""
    expires=""
    prev=""
    for token in $elem; do
      if [ -z "$key" ]; then
        key="$token"
        continue
      fi
      if [ "$prev" = "expires" ]; then
        expires="$token"
        break
      fi
      prev="$token"
    done

    [ -n "$expires" ] || continue
    ms="$(portknock_ms "$expires")" || continue
    key="${key#\"}"; key="${key%\"}"
    [ -n "$key" ] || continue
    printf '%s|%s\n' "$ms" "$key"
  done
}


portknock_lookup()
{
  local entries ms key

  entries="$(portknock_entries)" || return 1
  while IFS='|' read -r ms key; do
    [ "$key" = "$KEY" ] || continue
    printf '%s\n' "$ms"
    return 0
  done <<EOF
$entries
EOF

  return 2
}


portknock_log_close()
{
  [ -e "$STOP_FLAG" ] && return 0
  logger -t firewall -p user.info "ANF:Portknock closed: $LABEL $KEY ($PORTS)" 2>/dev/null
}


portknock_log_warning()
{
  [ -e "$STOP_FLAG" ] && return 0
  logger -t firewall -p user.warning "ANF:Portknock close check failed: $LABEL $KEY ($PORTS): $CHECK_REASON" 2>/dev/null
}


portknock_rule_check()
{
  local rules line item proto port found
  local IFS=' ,'

  CHECK_REASON=""
  rules="$("$NFT" list chain inet "$TABLE" PORTKNOCK_CHAIN 2>/dev/null)" || {
    CHECK_REASON="cannot read PORTKNOCK_CHAIN"
    return 2
  }

  for item in $PORTS; do
    case "$item" in
      */*) proto="${item%%/*}"; port="${item#*/}" ;;
      *)   proto="tcp"; port="$item" ;;
    esac

    case "$port" in
      ""|*[!0-9]*)
        CHECK_REASON="invalid target port $item"
        return 1
        ;;
    esac

    found=0
    while IFS= read -r line; do
      case "$line" in
        *"accept"*) ;;
        *) continue ;;
      esac
      case "$line" in
        *"@$SET"*) ;;
        *) continue ;;
      esac
      case "$line" in
        *"$proto dport"*) ;;
        *) continue ;;
      esac
      printf '%s\n' "$line" | grep -Eq "(^|[^0-9])$port([^0-9]|$)" || continue
      found=1
      break
    done <<EOF
$rules
EOF

    if [ "$found" != "1" ]; then
      CHECK_REASON="accept rule missing for $proto/$port"
      return 1
    fi
  done

  return 0
}


portknock_interface_check()
{
  local rules line pattern prefix

  CHECK_REASON=""
  [ -n "$IN_IF" ] || {
    CHECK_REASON="interface is empty"
    return 1
  }

  rules="$("$NFT" list chain inet "$TABLE" EXT_INPUT_CHAIN 2>/dev/null)" || {
    CHECK_REASON="cannot read EXT_INPUT_CHAIN"
    return 2
  }

  while IFS= read -r line; do
    case "$line" in
      *"jump PORTKNOCK_CHAIN"*) ;;
      *) continue ;;
    esac

    pattern="$(printf '%s\n' "$line" | sed -n 's/.*iifname "\([^"]*\)".*/\1/p')"
    [ -n "$pattern" ] || continue
    case "$pattern" in
      *\*)
        prefix="${pattern%\*}"
        case "$IN_IF" in
          "$prefix"*) return 0 ;;
        esac
        ;;
      *)
        [ "$IN_IF" = "$pattern" ] && return 0
        ;;
    esac
  done <<EOF
$rules
EOF

  CHECK_REASON="interface jump for $IN_IF missing"
  return 1
}


portknock_close_check()
{
  local rc

  portknock_rule_check
  rc=$?
  [ "$rc" -eq 0 ] || return "$rc"

  portknock_interface_check
  return $?
}


while :; do
  [ -e "$STOP_FLAG" ] && exit 0

  expires_ms="$(portknock_lookup)"; rc=$?
  case "$rc" in
    1)
      sleep 1
      continue
      ;;
    2)
      ;;
    0)
      case "$expires_ms" in
        ""|*[!0-9]*)
          sleep 1
          continue
          ;;
      esac
      if [ "$expires_ms" -gt 0 ] 2>/dev/null; then
        sleep_secs=$(( (expires_ms + 999) / 1000 ))
        [ "$sleep_secs" -gt 0 ] 2>/dev/null || sleep_secs=1
        sleep "$sleep_secs"
        continue
      fi
      ;;
  esac

  sleep 1
  [ -e "$STOP_FLAG" ] && exit 0

  expires_ms="$(portknock_lookup)"; rc=$?
  case "$rc" in
    1)
      sleep 1
      continue
      ;;
    2)
      ;;
    0)
      case "$expires_ms" in
        ""|*[!0-9]*)
          sleep 1
          continue
          ;;
      esac
      if [ "$expires_ms" -gt 0 ] 2>/dev/null; then
        continue
      fi
      ;;
  esac

  portknock_close_check
  check_rc=$?
  if [ "$check_rc" -eq 0 ]; then
    portknock_log_close
  else
    portknock_log_warning
  fi

  break
done
